APP_NAME=SIMPEG
APP_ENV=local
# Set TRUSTED_PROXIES to the actual proxy IPs/CIDRs when deploying behind a proxy.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masq2971_simpeg_dummy
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# Production cleanup is disabled by default. Enable only for an authorized admin
# after confirming that backups and the cleanup audit table are ready.
PAYROLL_PRODUCTION_HISTORY_CLEANUP=false

SSO_ENABLED=false
SSO_BASE_URL=http://localhost/rest_api_sso
SSO_APP=simpeg
SSO_TIMEOUT=10
SSO_CONNECT_TIMEOUT=5
SSO_VERIFY=true
SSO_CA_BUNDLE=

# Optional emergency local account. Disabled by default; keep the password
# only in the deployment server .env and never commit it to Git.
EMERGENCY_ACCOUNT_ENABLED=false
EMERGENCY_ACCOUNT_ID=adhikusuma
EMERGENCY_ACCOUNT_PASSWORD=
EMERGENCY_ACCOUNT_NAME="IT Administrator"

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
AUDIT_LOG_ENABLED=true
AUDIT_LOG_QUEUE_CONNECTION=deferred
AUDIT_LOG_QUEUE=audit
AUDIT_LOG_RETENTION_DAYS=180
IP_GEOLOCATION_ENABLED=false
IP_GEOLOCATION_BASE_URL=https://ipwho.is
IP_GEOLOCATION_TIMEOUT=2
IP_GEOLOCATION_CACHE_DAYS=30

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
